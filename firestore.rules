rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // A friendship document exists for this pair, in either uid order.
    function isFriend(other) {
      return signedIn() && (
        exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + other)) ||
        exists(/databases/$(database)/documents/friendships/$(other + '_' + request.auth.uid))
      );
    }

    // The recipient of a request is the only one who may turn it into a friendship.
    function acceptedRequestExists(requestId, from, to) {
      return signedIn() &&
        get(/databases/$(database)/documents/friendRequests/$(requestId)).data.from == from &&
        get(/databases/$(database)/documents/friendRequests/$(requestId)).data.to == to &&
        get(/databases/$(database)/documents/friendRequests/$(requestId)).data.status in ['pending', 'accepted'];
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailLower == request.auth.token.email.lower();
      allow delete: if false;

      match /nights/{nightId} {
        allow read: if signedIn() && (request.auth.uid == uid || isFriend(uid));
        allow write: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /emailIndex/{email} {
      // get is allowed, list is not: search is by exact address only.
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && email == request.auth.token.email.lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (
        resource == null ||
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.status == 'pending'
        && (requestId == request.resource.data.from + '_' + request.resource.data.to ||
            requestId == request.resource.data.to + '_' + request.resource.data.from);
      allow update: if signedIn()
        && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );
    }

    // The nightly roast. Written only by the roast worker, which uses its own
    // server credentials; a signed-in member may read the paragraph written
    // for their pair. `resource == null` allows the app to watch a document
    // that does not exist yet without a permission error.
    match /narratives/{pairId} {
      allow read: if signedIn() && (
        resource == null || request.auth.uid in resource.data.members
      );
      allow write: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && acceptedRequestExists(
             request.resource.data.requestId,
             request.resource.data.members[0] == request.auth.uid
               ? request.resource.data.members[1]
               : request.resource.data.members[0],
             request.auth.uid
           )
        && (friendshipId == request.resource.data.members[0] + '_' + request.resource.data.members[1] ||
            friendshipId == request.resource.data.members[1] + '_' + request.resource.data.members[0]);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if false;
    }
  }
}
